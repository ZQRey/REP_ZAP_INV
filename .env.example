# REP_ZAP_INV deployment environment template.
# Run ./scripts/init-env.sh to create .env with cryptographically random secrets.
# Never commit the generated .env file.

APP_ENV=production

# PostgreSQL (internal Docker service: postgres-db)
POSTGRES_USER=app_user
POSTGRES_DB=it_management
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
DATABASE_URL=postgresql://app_user:CHANGE_ME_GENERATED@postgres-db:5432/it_management

# Redis (internal Docker service: redis)
REDIS_PASSWORD=CHANGE_ME_GENERATED
REDIS_URL=redis://:CHANGE_ME_GENERATED@redis:6379/0

# Application signing/encryption keys. Generated independently.
SECRET_KEY=CHANGE_ME_GENERATED
NETWORK_CREDENTIAL_KEY=CHANGE_ME_GENERATED

# Evolution API / WhatsApp gateway.
EVOLUTION_API_KEY=CHANGE_ME_GENERATED
EVOLUTION_DATABASE_URL=postgresql://app_user:CHANGE_ME_GENERATED@postgres-db:5432/evolution
EVOLUTION_REDIS_URL=redis://:CHANGE_ME_GENERATED@redis:6379/1

# Optional deployment settings.
CORS_ORIGINS=
LDAP_ENABLED=false
LDAP_BIND_PASSWORD=
NETWORK_ALLOWED_CIDRS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
