# Copy to .env (ignored). Generate independent random values; never commit them.
APP_ENV=production
SECRET_KEY=
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=
EVOLUTION_API_KEY=
EVOLUTION_DATABASE_URL=
EVOLUTION_REDIS_URL=
CORS_ORIGINS=
LDAP_ENABLED=false
LDAP_BIND_PASSWORD=
NETWORK_ALLOWED_CIDRS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Application also accepts SECRET_KEY_FILE, DATABASE_URL_FILE, REDIS_URL_FILE,
# EVOLUTION_API_KEY_FILE and LDAP_BIND_PASSWORD_FILE instead of corresponding values.
# TLS_CA_FILE=/run/secrets/company-ca.crt
# SSH_KNOWN_HOSTS=/run/ssh/known_hosts
